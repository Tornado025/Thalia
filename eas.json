{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ASR_ENGINE": "whisper"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ASR_ENGINE": "whisper"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_ASR_ENGINE": "whisper"
      }
    }
  }
}
